<UserControl x:Class="DotLight.Knobs.TimerKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid Margin="2,2,2,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The dial: scroll over it to turn. The lit arc is the time; it drains while counting down. -->
    <Grid x:Name="DialFace" Width="132" Height="132" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS"
          ToolTip="Scroll to set the minutes">
      <Canvas x:Name="Ticks" Width="132" Height="132"/>
      <Path x:Name="Arc" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Orange}">
        <Path.Effect>
          <DropShadowEffect x:Name="ArcGlow" ShadowDepth="0" BlurRadius="12" Opacity="0.7"/>
        </Path.Effect>
      </Path>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="BigTime" Text="25:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        <TextBlock x:Name="Caption" Text="scroll to set" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Column="1" Margin="12,6,0,0">
      <TextBlock Text="Focus timer" FontWeight="SemiBold"/>
      <TextBlock Text="The island counts down with a draining light." Foreground="{StaticResource Muted}" FontSize="10.5"
                 TextWrapping="Wrap" Margin="0,2,0,0"/>
      <WrapPanel x:Name="Presets" Margin="0,10,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="StartBtn" Style="{StaticResource AccentBtn}" Background="{DynamicResource Orange}" Content="Start" Click="Start_Click" MinWidth="70"/>
        <Button x:Name="ResetBtn" Style="{StaticResource TextBtn}" Content="Reset" Margin="5,0,0,0" Click="Reset_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
