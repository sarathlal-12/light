<UserControl x:Class="DotLight.Knobs.ClipboardKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Search" TextChanged="Search_Changed"/>
      <TextBlock x:Name="Placeholder" Text="Search clips" Foreground="{StaticResource Muted}" Margin="11,0" FontSize="12"
                 VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Button x:Name="GrabTextBtn" Grid.Column="1" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="12" Margin="5,0,0,0"
              Content="&#xE8B3;" ToolTip="Grab text from screen" Click="Grab_Click"/>
      <Button x:Name="GrabImageBtn" Grid.Column="2" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="12" Margin="2,0,0,0"
              Content="&#xE7A8;" ToolTip="Grab image from screen" Click="GrabImage_Click"/>
      <ToggleButton x:Name="PauseBtn" Grid.Column="3" Style="{StaticResource IconToggle}" Width="28" Height="28" FontSize="11" Margin="2,0,0,0"
                    Content="&#xE769;" ToolTip="Pause clipboard history (new copies aren't saved)" Click="Pause_Click"/>
      <Button Grid.Column="4" Style="{StaticResource TextBtn}" Content="Clear" ToolTip="Remove everything except pinned clips"
              Margin="5,0,0,0" Click="Clear_Click"/>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border MouseLeftButtonUp="Item_Click" PreviewMouseLeftButtonDown="Item_Down" PreviewMouseMove="Item_Move"
                    ToolTip="Click to copy · drag into any app">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource HoverRow}">
                  <Style.Triggers>
                    <!-- the clip the dial is pointing at -->
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                      <Setter Property="Background" Value="#26FFFFFF"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
                      <Setter Property="BorderThickness" Value="2,0,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <DockPanel Visibility="{Binding IsText, Converter={StaticResource BoolVis}}">
                    <!-- colour clips show the colour itself -->
                    <Ellipse DockPanel.Dock="Left" Width="11" Height="11" Margin="0,2,6,0" VerticalAlignment="Top"
                             Fill="{Binding SwatchBrush}" Stroke="#40FFFFFF" StrokeThickness="1"
                             Visibility="{Binding HasSwatch, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" FontSize="12"/>
                  </DockPanel>
                  <Image Source="{Binding Thumb}" MaxHeight="44" HorizontalAlignment="Left" Stretch="Uniform"
                         Visibility="{Binding IsImage, Converter={StaticResource BoolVis}}"/>
                  <!-- smart actions: Clean link, Open, RGB, Show in folder, Tidy… -->
                  <ItemsControl ItemsSource="{Binding Actions}" Margin="0,4,0,0"
                                Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ChipBtn}" Content="{Binding Label}" Click="Action_Click"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource Muted}" FontSize="9.5" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="11"
                        VerticalAlignment="Top" Content="{Binding PinGlyph}" Opacity="{Binding PinOpacity}"
                        ToolTip="Pin" Click="Pin_Click"/>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="9"
                        VerticalAlignment="Top" Content="&#xE711;" Opacity="0.5" ToolTip="Remove" Click="Delete_Click"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="Hint" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,4,0,0"/>
  </Grid>
</UserControl>
