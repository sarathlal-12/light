<UserControl x:Class="DotLight.Knobs.SettingsKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- A shortcut you can click and then press new keys for -->
    <Style x:Key="KeyBox" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="92"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{StaticResource Surface}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="9,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- One island style to pick, with a tiny picture of it -->
    <Style x:Key="StyleTile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" Height="50" CornerRadius="9" Background="#111114" BorderBrush="#30FFFFFF" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#70FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Green}"/>
                <Setter TargetName="B" Property="BorderThickness" Value="1.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="Rows" Margin="2,0,6,6">

      <!-- What's new: shown after an update until you close it -->
      <Border x:Name="WhatsNew" CornerRadius="12" Background="{StaticResource Surface}" Padding="11,9" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="22" Height="22" FontSize="9" Content="&#xE711;"
                    ToolTip="Hide" Click="WhatsNewClose_Click" VerticalAlignment="Top"/>
            <TextBlock x:Name="WhatsNewTitle" Text="What's new" FontWeight="SemiBold"/>
          </DockPanel>
          <TextBlock Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="15">
            • Phone tab: your Android or iPhone notifications through Phone Link, Copy buttons for login codes, calls and battery.<LineBreak/>
            • Copy on the phone, paste on the PC: Android through Phone Link; iPhone with the "Send to .light" Shortcut (Phone tab, clipboard button).<LineBreak/>
            • Claude tab: every Claude Code session, Working with a timer, Needs your OK or Done, and a soft pop when it finishes.<LineBreak/>
            • Screenshots pop up on the island: drag them into any app. Clips drag out too, and the clipboard can be paused.<LineBreak/>
            • Camera and mic dots, charging, finished downloads and update notices. Switch any of them off below.
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Light colour -->
      <DockPanel>
        <TextBlock x:Name="LightName" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11"
                   VerticalAlignment="Bottom"/>
        <TextBlock Text="Light" FontWeight="SemiBold"/>
      </DockPanel>
      <TextBlock Text="The colour .light glows in." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,1,0,0"/>
      <WrapPanel x:Name="Lights" Margin="0,8,0,0"/>

      <!-- Island style -->
      <DockPanel Margin="0,12,0,0">
        <TextBlock x:Name="StyleName" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Bottom"/>
        <TextBlock Text="Island" FontWeight="SemiBold"/>
      </DockPanel>
      <TextBlock Text="How the island rests when nothing is happening." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,1,0,0"/>
      <UniformGrid x:Name="Styles" Rows="1" Margin="0,8,0,0"/>

      <DockPanel Margin="0,10,0,0">
        <ToggleButton x:Name="ClockSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Clock_Click" VerticalAlignment="Center"/>
        <TextBlock Text="Show the time" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Margin="0,8,0,0">
        <ToggleButton x:Name="BreathSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Breath_Click" VerticalAlignment="Center"/>
        <TextBlock Text="Breathing light" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Features: switch any of them off -->
      <TextBlock Text="Features" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="Turn off what you don't use; its tab and shortcut go away." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,1,0,0" TextWrapping="Wrap"/>
      <DockPanel Margin="0,8,0,0">
        <ToggleButton x:Name="AgentSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Agent_Click" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Claude Code status"/>
          <TextBlock Text="Shows when it needs your OK or has finished" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="AgentHint" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <StackPanel x:Name="FeatureRows"/>

      <!-- Shortcuts -->
      <TextBlock Text="Shortcuts" FontWeight="SemiBold" Margin="0,14,0,0"/>
      <TextBlock Text="Click one, then press the new keys. Esc cancels." Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,1,0,0"/>
      <DockPanel Margin="0,8,0,0">
        <Button x:Name="KeyOpen" DockPanel.Dock="Right" Style="{StaticResource KeyBox}" Tag="open" Click="Key_Click"/>
        <TextBlock Text="Open .light" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel x:Name="KeyGrabRow" Margin="0,6,0,0">
        <Button x:Name="KeyGrab" DockPanel.Dock="Right" Style="{StaticResource KeyBox}" Tag="grab" Click="Key_Click"/>
        <TextBlock Text="Grab text from screen" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel x:Name="KeyImageRow" Margin="0,6,0,0">
        <Button x:Name="KeyImage" DockPanel.Dock="Right" Style="{StaticResource KeyBox}" Tag="image" Click="Key_Click"/>
        <TextBlock Text="Grab image from screen" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="KeyHint" Foreground="{DynamicResource Orange}" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <Button Style="{StaticResource TextBtn}" Content="Reset shortcuts" HorizontalAlignment="Left" Margin="-6,4,0,0" FontSize="11" Click="ResetKeys_Click"/>

      <!-- Position -->
      <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock Text="Tap a spot, or drag the island by its top bar." Foreground="{StaticResource Muted}"
                 FontSize="10.5" Margin="0,1,0,0"/>

      <!-- A tiny picture of your screen: tap where the island should live -->
      <Border Width="196" Height="100" CornerRadius="9" Margin="0,8,0,0" HorizontalAlignment="Center"
              Background="#111114" BorderBrush="#30FFFFFF" BorderThickness="1">
        <Grid>
          <!-- taskbar -->
          <Border Height="9" VerticalAlignment="Bottom" CornerRadius="0,0,8,8" Background="#1CFFFFFF"/>
          <Grid x:Name="Spots" Margin="4,2,4,10">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
          </Grid>
        </Grid>
      </Border>
      <TextBlock x:Name="SpotName" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,4,0,0"/>

      <DockPanel Margin="0,12,0,0">
        <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click"
                      VerticalAlignment="Center"/>
        <TextBlock Text="Start with Windows" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
