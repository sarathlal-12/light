<UserControl x:Class="DotLight.Knobs.MusicKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Nothing playing -->
    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
      <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource Muted}"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="Nothing playing" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock Text="Play something in Spotify, YouTube or any app."
                 Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                 MaxWidth="230" Margin="0,3,0,0"/>
    </StackPanel>

    <!-- Now playing -->
    <StackPanel x:Name="Player" Visibility="Collapsed" Margin="2,4,2,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="CoverBox" Width="78" Height="78" CornerRadius="10" Background="{StaticResource Surface}">
          <Grid>
            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="22" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border CornerRadius="10">
              <Border.Background>
                <ImageBrush x:Name="Cover" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <DockPanel>
            <!-- bars that move with the real sound -->
            <StackPanel x:Name="Wave" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Height="12"/>
            <TextBlock x:Name="AppText" Foreground="{StaticResource Muted}" FontSize="9.5" FontWeight="SemiBold"/>
          </DockPanel>
          <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,3,0,0"/>
          <TextBlock x:Name="ArtistText" Foreground="{StaticResource Muted}" FontSize="11.5"
                     TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>

      <!-- Progress (hidden when the app doesn't report it) -->
      <Grid x:Name="ProgressRow" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PosText" Text="0:00" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
        <Slider x:Name="Seek" Grid.Column="1" Foreground="{DynamicResource Green}" Loaded="Seek_Loaded" Minimum="0" Maximum="1"
                PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
        <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" Foreground="{StaticResource Muted}" FontSize="10"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}" Width="34" Height="34" FontSize="14"
                Content="&#xE892;" ToolTip="Previous" Click="Prev_Click"/>
        <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Width="40" Height="40" FontSize="15" Margin="12,0"
                Content="&#xE768;" ToolTip="Play / pause" Click="Play_Click"/>
        <Button x:Name="NextBtn" Style="{StaticResource IconBtn}" Width="34" Height="34" FontSize="14"
                Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
