<UserControl x:Class="DotLight.Knobs.MusicKnob"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Nothing playing -->
    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
      <Border Width="72" Height="72" CornerRadius="22" Background="#1C1C1E" HorizontalAlignment="Center">
        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="28" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="Nothing playing" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
      <TextBlock Text="Play something in Spotify, YouTube or any app." Foreground="{StaticResource Muted}" FontSize="14"
                 TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- Now playing -->
    <Grid x:Name="Player" Visibility="Collapsed" Margin="2,6,2,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="CoverBox" Width="232" Height="232" CornerRadius="30" Background="#2C2C2E" VerticalAlignment="Top">
        <Grid>
          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="40" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border CornerRadius="30">
            <Border.Background>
              <ImageBrush x:Name="Cover" Stretch="UniformToFill"/>
            </Border.Background>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="28,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource Green}" VerticalAlignment="Center"/>
            <TextBlock x:Name="AppText" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,1"/>
          </StackPanel>
          <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                     MaxHeight="72" LineHeight="34" Margin="0,10,0,0"/>
          <TextBlock x:Name="ArtistText" Foreground="{StaticResource Muted}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
          <!-- bars that move with the real sound -->
          <StackPanel x:Name="Wave" Orientation="Horizontal" Height="34" Margin="0,16,0,0" HorizontalAlignment="Left"/>
          <!-- Progress (hidden when the app doesn't report it) -->
          <Grid x:Name="ProgressRow" Margin="0,12,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Slider x:Name="Seek" Foreground="White" Loaded="Seek_Loaded" Minimum="0" Maximum="1"
                    PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
            <DockPanel Grid.Row="1" Margin="0,4,0,0">
              <TextBlock x:Name="DurText" DockPanel.Dock="Right" Text="0:00" Foreground="{StaticResource Muted}" FontSize="12"
                         Typography.NumeralAlignment="Tabular"/>
              <TextBlock x:Name="PosText" Text="0:00" Foreground="{StaticResource Muted}" FontSize="12" Typography.NumeralAlignment="Tabular"/>
            </DockPanel>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button x:Name="PrevBtn" Style="{StaticResource PlayBtn}" Background="#1C1C1E" Foreground="White" Width="52" Height="52" FontSize="17"
                  Content="&#xE892;" ToolTip="Previous" Click="Prev_Click"/>
          <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Background="White" Foreground="Black" Width="64" Height="64" FontSize="21"
                  Margin="14,0" Content="&#xE768;" ToolTip="Play / pause" Click="Play_Click"/>
          <Button x:Name="NextBtn" Style="{StaticResource PlayBtn}" Background="#1C1C1E" Foreground="White" Width="52" Height="52" FontSize="17"
                  Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
